    <div class="path">frontend/src/pages/Dashboard.js</div>
    <pre><code>import React, { useContext } from 'react';
import { AuthContext } from '../context/AuthContext';

const Dashboard = () => {
    const { user } = useContext(AuthContext);

    return (
        &lt;div&gt;
            &lt;h2&gt;Dashboard&lt;/h2&gt;
            &lt;p&gt;Welcome back, &lt;strong&gt;{user?.full_name}&lt;/strong&gt;!&lt;/p&gt;
            
            &lt;div style={{ marginTop: '20px', padding: '15px', border: '1px solid #ccc', width: '300px' }}&gt;
                &lt;h3&gt;Quick Stats&lt;/h3&gt;
                &lt;p&gt;Total Active Chits: 3&lt;/p&gt;
                &lt;p&gt;Total Investment: ₹1,50,000&lt;/p&gt;
            &lt;/div&gt;
        &lt;/div&gt;
    );
};

export default Dashboard;</code></pre>

    <h3>24. Chit List Page</h3>
    <p>Fetches and displays all chit groups owned by the user.</p>
    <div class="path">frontend/src/pages/ChitList.js</div>
    <pre><code>import React, { useEffect, useState } from 'react';
import api from '../api/axios';

const ChitList = () => {
    const [chits, setChits] = useState([]);

    useEffect(() => {
        const fetchChits = async () => {
            try {
                const res = await api.get('/chits/');
                setChits(res.data);
            } catch (error) {
                console.error("Failed to fetch chits", error);
            }
        };
        fetchChits();
    }, []);

    return (
        &lt;div&gt;
            &lt;h2&gt;Your Chit Groups&lt;/h2&gt;
            &lt;ul&gt;
                {chits.map(chit =&gt; (
                    &lt;li key={chit.id} style={{ marginBottom: '10px', padding: '10px', border: '1px solid #ddd' }}&gt;
                        &lt;strong&gt;{chit.name}&lt;/strong&gt; &lt;br/&gt;
                        Value: ₹{chit.total_value} | Duration: {chit.months} Months
                    &lt;/li&gt;
                ))}
            &lt;/ul&gt;
        &lt;/div&gt;
    );
};

export default ChitList;</code></pre>

    <h3>25. Create Chit Page</h3>
    <p>Form to create a new chit group.</p>
    <div class="path">frontend/src/pages/CreateChit.js</div>
    <pre><code>import React, { useState } from 'react';
import api from '../api/axios';

const CreateChit = () => {
    const [form, setForm] = useState({ name: '', total_value: 0, months: 0 });

    const handleSubmit = async (e) => {
        e.preventDefault();
        try {
            await api.post('/chits/', form);
            alert('Chit created successfully!');
        } catch (err) {
            alert('Failed to create chit group');
        }
    };

    return (
        &lt;div&gt;
            &lt;h2&gt;Create New Chit&lt;/h2&gt;
            &lt;form onSubmit={handleSubmit}&gt;
                &lt;input type="text" placeholder="Chit Name (e.g., Deepavali Fund)" onChange={(e) =&gt; setForm({...form, name: e.target.value})} required /&gt; &lt;br/&gt;&lt;br/&gt;
                &lt;input type="number" placeholder="Total Value (e.g., 100000)" onChange={(e) =&gt; setForm({...form, total_value: Number(e.target.value)})} required /&gt; &lt;br/&gt;&lt;br/&gt;
                &lt;input type="number" placeholder="Months (e.g., 20)" onChange={(e) =&gt; setForm({...form, months: Number(e.target.value)})} required /&gt; &lt;br/&gt;&lt;br/&gt;
                &lt;button type="submit"&gt;Create Group&lt;/button&gt;
            &lt;/form&gt;
        &lt;/div&gt;
    );
};

export default CreateChit;</code></pre>

    <h3>26. Chit Detail Component</h3>
    <p>Shows individual chit group details with ID from URL parameters.</p>
    <div class="path">frontend/src/pages/ChitDetail.js</div>
    <pre><code>import React, { useEffect, useState } from 'react';
import { useParams } from 'react-router-dom';
import api from '../api/axios';

const ChitDetail = () => {
    const { id } = useParams();
    const [chit, setChit] = useState(null);

    useEffect(() => {
        const fetchDetail = async () => {
            try {
                const res = await api.get(`/chits/${id}`);
                setChit(res.data);
            } catch (err) {
                console.error(err);
            }
        };
        fetchDetail();
    }, [id]);

    if (!chit) return &lt;p&gt;Loading details...&lt;/p&gt;;

    return (
        &lt;div style={{ padding: '20px', border: '1px solid #2F5496' }}&gt;
            &lt;h2&gt;{chit.name} - Details&lt;/h2&gt;
            &lt;p&gt;&lt;strong&gt;Total Value:&lt;/strong&gt; ₹{chit.total_value}&lt;/p&gt;
            &lt;p&gt;&lt;strong&gt;Duration:&lt;/strong&gt; {chit.months} Months&lt;/p&gt;
            &lt;p&gt;&lt;strong&gt;EMI / Month:&lt;/strong&gt; ₹{(chit.total_value / chit.months).toFixed(2)}&lt;/p&gt;
            &lt;p&gt;&lt;strong&gt;Started on:&lt;/strong&gt; {new Date(chit.created_at).toLocaleDateString()}&lt;/p&gt;
        &lt;/div&gt;
    );
};

export default ChitDetail;</code></pre>

    <h3>27. User Profile Page</h3>
    <p>Allows users to view and update their profile.</p>
    <div class="path">frontend/src/pages/Profile.js</div>
    <pre><code>import React, { useContext, useState } from 'react';
import { AuthContext } from '../context/AuthContext';
import api from '../api/axios';

const Profile = () => {
    const { user, setUser } = useContext(AuthContext);
    const [name, setName] = useState(user?.full_name || '');

    const handleUpdate = async () => {
        try {
            const res = await api.put('/users/me', { full_name: name });
            setUser(res.data);
            alert('Profile updated successfully!');
        } catch (error) {
            alert('Update failed');
        }
    };

    return (
        &lt;div&gt;
            &lt;h2&gt;Your Profile Settings&lt;/h2&gt;
            &lt;p&gt;Email: {user?.email} (Cannot be changed)&lt;/p&gt;
            
            &lt;label&gt;Full Name: &lt;/label&gt;
            &lt;input type="text" value={name} onChange={(e) =&gt; setName(e.target.value)} /&gt; 
            &lt;br/&gt;&lt;br/&gt;
            &lt;button onClick={handleUpdate}&gt;Update Name&lt;/button&gt;
        &lt;/div&gt;
    );
};

export default Profile;</code></pre>

    <h3>28. Sidebar Component</h3>
    <p>Additional navigation component for deep linking.</p>
    <div class="path">frontend/src/components/Sidebar.js</div>
    <pre><code>import React from 'react';
import { Link } from 'react-router-dom';

const Sidebar = () => {
    return (
        &lt;aside style={{ width: '250px', background: '#f4f4f4', minHeight: '100vh', padding: '20px' }}&gt;
            &lt;ul style={{ listStyleType: 'none', padding: 0 }}&gt;
                &lt;li style={{ marginBottom: '15px' }}&gt;&lt;Link to="/"&gt;Dashboard&lt;/Link&gt;&lt;/li&gt;
                &lt;li style={{ marginBottom: '15px' }}&gt;&lt;Link to="/chits"&gt;Manage Chits&lt;/Link&gt;&lt;/li&gt;
                &lt;li style={{ marginBottom: '15px' }}&gt;&lt;Link to="/chits/new"&gt;Create New Chit&lt;/Link&gt;&lt;/li&gt;
                &lt;li style={{ marginBottom: '15px' }}&gt;&lt;Link to="/profile"&gt;Account Settings&lt;/Link&gt;&lt;/li&gt;
            &lt;/ul&gt;
        &lt;/aside&gt;
    );
};

export default Sidebar;</code></pre>

    <h3>29. Utility Helpers</h3>
    <p>Common helper functions for formatting data.</p>
    <div class="path">frontend/src/utils/helpers.js</div>
    <pre><code>export const formatCurrency = (amount) => {
    return new Intl.NumberFormat('en-IN', {
        style: 'currency',
        currency: 'INR'
    }).format(amount);
};

export const calculateEMI = (totalValue, months) => {
    if (!months || months === 0) return 0;
    return (totalValue / months).toFixed(2);
};

export const formatDate = (dateString) => {
    const options = { year: 'numeric', month: 'short', day: 'numeric' };
    return new Date(dateString).toLocaleDateString('en-IN', options);
};</code></pre>

    <h3>30. Application Entry Point</h3>
    <p>Bootstraps the React application into the root DOM node.</p>
    <div class="path">frontend/src/index.js</div>
    <pre><code>import React from 'react';
import ReactDOM from 'react-dom/client';
import App from './App';
import './index.css';

const root = ReactDOM.createRoot(document.getElementById('root'));
root.render(
    &lt;React.StrictMode&gt;
        &lt;App /&gt;
    &lt;/React.StrictMode&gt;
);</code></pre>

</body>
</html>
